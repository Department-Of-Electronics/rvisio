        },
        {
          "text": "file app.elf"
        },
        {
          "text": "target extended-remote 127.0.0.1:3333"
        },
        {
          "text": "monitor erase"
        },
        {
          "text": "load"
        },
        {
          "text": "tbreak main"
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "program": "${workspaceFolder}/app.elf",
      "cwd": "${workspaceFolder}",
      "miDebuggerPath": "gdb-multiarch",
      "preLaunchTask": "make"
    },
    {
      "name": "SoC, Windows (xPack, no WSL)",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "gdb",
      "targetArchitecture": "arm",
      "customLaunchSetupCommands": [
