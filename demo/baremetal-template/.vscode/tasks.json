{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make",
      "type": "process",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make (WSL)",
      "type": "process",
      "command": "C:\\Windows\\System32\\wsl.exe",
      "args": [
        "--",
        "make"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make (xPack)",
      "type": "process",
      "command": "make",
      "args": [
        "CROSS=riscv-none-elf-"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}